# Optional overrides; copying this file is not required.
# Empty paths reuse Chapter 1's repository-root .env, then default to
# ./models/Qwen3-1.7B and ./alfworld_data, even before those folders exist.
# Relative paths are resolved from the repository root. Explicit nonempty
# environment paths take precedence over this file.
TRINITY_MODEL_PATH=
ALFWORLD_DATA=

# Keep this directory and experiment name when resuming.
# Environments, services, credentials and checkpoints live here.
# Model and game data use the shared Chapter 1 paths above.
LORA32_WORK_DIR="$HOME/.cache/agentic-rl/alfworld-lora32"
TRINITY_MACHINE_ID=reader72_001

# Normally no changes needed: dedicated localhost ports (base through base+20).
LORA32_PORT_BASE=16380

# Copy to .env and adjust. .env is gitignored — never commit real paths/keys.
#
# 路径可写相对路径（相对仓库根目录解析，因为 run.sh 会先 cd 到仓库根目录），
# 也可写绝对路径。下面的默认值是相对路径，按需改成你自己的位置即可。

# ALFWorld 数据根目录：其中应包含 json_2.1.1/ 和 logic/，不要填 json_2.1.1 本身。
# 装好 alfworld 后用 `alfworld-download` 下载，数据会落到 $ALFWORLD_DATA。
ALFWORLD_DATA=./alfworld_data

# 本地 base 模型 checkpoint 目录（HF 格式）。本教程用 Qwen3-1.7B。
TRINITY_MODEL_PATH=./models/Qwen3-1.7B

# 可选：checkpoint / buffer 的写出目录（默认 ./checkpoints）。
# TRINITY_CHECKPOINT_ROOT_DIR=./checkpoints

# 全参数示例：默认在本机启动 Ray，固定服务端口为 16376–16379；worker 使用动态端口。
# 若这些端口被占用，指定另一段空闲端口（此值及前 3 个端口）。
# TRINITY_RAY_PORT=16379
# 若要复用已有且与 .venv 版本一致的 Ray，填写实际 host:port。
# 设置后只检查并连接该集群，不再自动启动；不要填 auto/local。
# RAY_ADDRESS=127.0.0.1:16379

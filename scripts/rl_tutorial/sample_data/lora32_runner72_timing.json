  "formula": {
    "interval": "wall_seconds[s] = timestamp[s] - timestamp[s-1], s=103..150; timestamp[102] is window.previous_endpoint.",
    "mean": "mean_wall_seconds = sum(wall_seconds) / 48 = (timestamp[150] - timestamp[102]) / 48",
    "budget": "estimated_hours[N] = N * mean_wall_seconds / 3600",
